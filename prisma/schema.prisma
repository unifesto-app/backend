// Unifesto Authentication & User System
// Prisma Schema - Single Source of Truth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Provider {
  GOOGLE
  APPLE
  EMAIL
  PHONE

  @@map("provider")
}

enum RoleScope {
  PLATFORM
  SPACE

  @@map("role_scope")
}

enum RoleCode {
  ADMIN
  SUPER_ORGANISER
  ORGANISER
  CO_ORGANISER
  MEMBER

  @@map("role_code")
}

enum SpaceStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("space_status")
}

enum SpaceVisibility {
  PUBLIC
  PRIVATE

  @@map("space_visibility")
}

// =====================================================
// USER MODEL
// Core user entity - one person = one account
// =====================================================

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identity (Canonical)
  mobileNumber   String  @unique @map("mobile_number") @db.VarChar(20)
  mobileVerified Boolean @default(false) @map("mobile_verified")

  // Profile
  username   String? @unique @db.VarChar(50)
  fullName   String? @map("full_name") @db.VarChar(255)
  avatarUrl  String? @map("avatar_url") @db.Text
  bio        String? @db.Text

  // Social Links
  linkedinUrl   String? @map("linkedin_url") @db.Text
  instagramUrl  String? @map("instagram_url") @db.Text
  githubUrl     String? @map("github_url") @db.Text
  websiteUrl    String? @map("website_url") @db.Text

  // Onboarding
  isOnboarded Boolean @default(false) @map("is_onboarded")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  identities       UserIdentity[]
  roles            UserRole[]        @relation("UserRoles")
  assignedRoles    UserRole[]        @relation("AssignedBy")
  createdSpaces    Space[]           @relation("SpaceCreator")
  discussions      Discussion[]
  discussionReplies DiscussionReply[]

  @@map("users")
}

// =====================================================
// USER IDENTITY MODEL
// Authentication methods linked to a single user
// =====================================================

model UserIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // User Reference
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provider Information
  provider       Provider
  providerUserId String   @map("provider_user_id") @db.Text

  // Email (may be null for phone provider)
  email         String?  @db.VarChar(255)
  emailVerified Boolean? @default(false) @map("email_verified")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Constraints
  @@unique([provider, providerUserId], name: "unique_provider_user")
  @@unique([provider, email], name: "unique_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([email])
  @@map("user_identities")
}

// =====================================================
// ROLE MODEL
// Simple role definitions
// =====================================================

model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code  RoleCode @unique
  name  String   @db.VarChar(100)
  scope RoleScope

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

// =====================================================
// USER ROLE MODEL
// Role assignments to users
// =====================================================

model UserRole {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // User Reference
  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  // Role Reference
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Space context (null for platform roles)
  spaceId String? @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Audit
  assignedBy     String? @map("assigned_by") @db.Uuid
  assignedByUser User?   @relation("AssignedBy", fields: [assignedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Constraints
  @@unique([userId, roleId, spaceId], name: "unique_user_role_space")
  @@index([userId])
  @@index([roleId])
  @@index([spaceId])
  @@map("user_roles")
}

// =====================================================
// SPACE MODEL
// Community spaces (formerly organizations)
// =====================================================

model Space {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Basic Information
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(100) // Like username, e.g., @tech-community
  description String?            @db.Text
  websiteUrl  String?            @map("website_url") @db.Text
  
  // Images
  logoUrl   String? @map("logo_url") @db.Text
  bannerUrl String? @map("banner_url") @db.Text

  // Location
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  country String? @db.VarChar(100)

  // Configuration
  tags       String[] // Array of tags
  visibility SpaceVisibility @default(PUBLIC)
  
  // Limits
  coOrganiserLimit Int @default(5) @map("co_organiser_limit") // Set by admin

  // Status & Workflow
  status        SpaceStatus @default(PENDING)
  submittedAt   DateTime?   @map("submitted_at") @db.Timestamptz(6)
  approvedAt    DateTime?   @map("approved_at") @db.Timestamptz(6)
  rejectedAt    DateTime?   @map("rejected_at") @db.Timestamptz(6)
  approvedBy    String?     @map("approved_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Creator
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("SpaceCreator", fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  userRoles   UserRole[]
  discussions Discussion[]
  // events Event[] // Placeholder for future

  @@index([slug])
  @@index([status])
  @@index([createdBy])
  @@map("spaces")
}

// =====================================================
// DISCUSSION MODEL
// Forum discussions within spaces
// =====================================================

model Discussion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Content
  title   String @db.VarChar(500)
  content String @db.Text

  // Space context
  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Author
  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Status
  isPinned  Boolean @default(false) @map("is_pinned")
  isLocked  Boolean @default(false) @map("is_locked")
  isDeleted Boolean @default(false) @map("is_deleted")

  // Engagement
  viewCount  Int @default(0) @map("view_count")
  replyCount Int @default(0) @map("reply_count")

  // Timestamps
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz(6)

  // Relations
  replies DiscussionReply[]

  @@index([spaceId])
  @@index([authorId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@map("discussions")
}

// =====================================================
// DISCUSSION REPLY MODEL
// Replies to discussions
// =====================================================

model DiscussionReply {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Content
  content String @db.Text

  // Discussion context
  discussionId String     @map("discussion_id") @db.Uuid
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  // Author
  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Status
  isDeleted Boolean @default(false) @map("is_deleted")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([discussionId])
  @@index([authorId])
  @@index([createdAt])
  @@map("discussion_replies")
}

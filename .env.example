# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your_anon_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database_name

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://auth.unifesto.app,https://admin.unifesto.app

# Frontend URLs (for redirects and links)
FRONTEND_AUTH_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:3002

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Email Configuration
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@unifesto.app

# Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# File Upload
STORAGE_BUCKET=unifesto-uploads
MAX_FILE_SIZE=52428800

# Feature Flags
ENABLE_MAINTENANCE_MODE=false
